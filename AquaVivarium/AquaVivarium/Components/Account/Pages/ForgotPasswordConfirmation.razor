@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Recuperación en desarrollo</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-10">
    <MudCard Class="pa-8 d-flex flex-column align-center text-center" Style="background-color: var(--av-bg-pure); border-radius: 12px;">

        <MudIcon Icon="@Icons.Material.Filled.Engineering"
                 Color="Color.Primary"
                 Style="font-size: 4rem;"
                 Class="mb-4" />

        <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight: 700; color: var(--av-text-main);">
            ¡Estamos trabajando en ello!
        </MudText>

        <MudText Typo="Typo.body1" Class="mb-6" Style="color: var(--av-text-muted);">
            El sistema de envío de correos para restablecer contraseñas se encuentra actualmente en desarrollo y aún no está disponible.
            <br /><br />
            Si no logras recordar tu contraseña, por favor contacta con el administrador del sistema para recuperar tu acceso.
        </MudText>

        <MudDivider Class="w-100 mb-6" Style="border-color: var(--av-border);" />

        <MudButton Href="/Account/Login"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Style="font-weight: 600; border-radius: 8px;">
            Volver a Iniciar Sesión
        </MudButton>

    </MudCard>
</MudContainer>