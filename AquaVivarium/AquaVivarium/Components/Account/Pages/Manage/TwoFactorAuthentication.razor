@page "/Account/Manage/TwoFactorAuthentication"

@using Domain.Models
@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using Data.Context

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Autenticación de dos factores (2FA)</PageTitle>

<MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--av-text-main);" Class="mb-4">Autenticación de dos factores (2FA)</MudText>

<StatusMessage />

<MudGrid>
    <MudItem xs="12" md="10" lg="8">
        @if (canTrack)
        {
            if (is2faEnabled)
            {
                if (recoveryCodesLeft == 0)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-6" Style="border-radius: 8px;">
                        <strong>No te quedan códigos de recuperación.</strong>
                        <p class="mb-0 mt-1">Debes <a href="Account/Manage/GenerateRecoveryCodes" style="color: inherit; text-decoration: underline;">generar un nuevo conjunto de códigos</a> antes de poder iniciar sesión con uno.</p>
                    </MudAlert>
                }
                else if (recoveryCodesLeft == 1)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-6" Style="border-radius: 8px;">
                        <strong>Te queda 1 código de recuperación.</strong>
                        <p class="mb-0 mt-1">Puedes <a href="Account/Manage/GenerateRecoveryCodes" style="color: inherit; text-decoration: underline;">generar un nuevo conjunto de códigos de recuperación</a>.</p>
                    </MudAlert>
                }
                else if (recoveryCodesLeft <= 3)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-6" Style="border-radius: 8px;">
                        <strong>Te quedan @recoveryCodesLeft códigos de recuperación.</strong>
                        <p class="mb-0 mt-1">Deberías <a href="Account/Manage/GenerateRecoveryCodes" style="color: inherit; text-decoration: underline;">generar un nuevo conjunto de códigos de recuperación</a>.</p>
                    </MudAlert>
                }

                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="4" Class="mb-8">
                    @if (isMachineRemembered)
                    {
                        <form style="display: inline-block; margin: 0;" @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                            <AntiforgeryToken />
                            <MudButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Outlined.Computer"
                                       Style="font-weight: 600; border-radius: 8px; border-width: 2px;">
                                Olvidar este navegador
                            </MudButton>
                        </form>
                    }

                    <MudButton Href="Account/Manage/Disable2fa"
                               Variant="Variant.Outlined"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Outlined.Security"
                               Style="font-weight: 600; border-radius: 8px; border-width: 2px;">
                        Deshabilitar 2FA
                    </MudButton>

                    <MudButton Href="Account/Manage/GenerateRecoveryCodes"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.VpnKey"
                               Style="font-weight: 600; border-radius: 8px; border-width: 2px;">
                        Restablecer códigos de recuperación
                    </MudButton>
                </MudStack>
            }

            <MudDivider Class="mb-6" />

            <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--av-text-main);" Class="mb-4">App Autenticadora</MudText>

            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="4">
                @if (!hasAuthenticator)
                {
                    <MudButton Href="Account/Manage/EnableAuthenticator"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.QrCodeScanner"
                               Style="font-weight: 600; border-radius: 8px;">
                        Añadir app autenticadora
                    </MudButton>
                }
                else
                {
                    <MudButton Href="Account/Manage/EnableAuthenticator"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Settings"
                               Style="font-weight: 600; border-radius: 8px;">
                        Configurar app autenticadora
                    </MudButton>

                    <MudButton Href="Account/Manage/ResetAuthenticator"
                               Variant="Variant.Outlined"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Outlined.RestartAlt"
                               Style="font-weight: 600; border-radius: 8px; border-width: 2px;">
                        Restablecer app autenticadora
                    </MudButton>
                }
            </MudStack>
        }
        else
        {
            <MudAlert Severity="Severity.Error" Class="mb-6" Style="border-radius: 8px;">
                <strong>No se ha aceptado la política de privacidad y cookies.</strong>
                <p class="mb-0 mt-1">Debes aceptar la política antes de poder habilitar la autenticación de dos factores.</p>
            </MudAlert>
        }
    </MudItem>
</MudGrid>

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "Se ha olvidado el navegador actual. Cuando vuelvas a iniciar sesión desde este navegador, se te pedirá tu código 2FA.",
            HttpContext);
    }
}