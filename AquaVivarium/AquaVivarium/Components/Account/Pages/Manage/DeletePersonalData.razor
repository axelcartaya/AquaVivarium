@page "/Account/Manage/DeletePersonalData"

@using System.ComponentModel.DataAnnotations
@using Domain.Models
@using Microsoft.AspNetCore.Identity
@using Data.Context

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger

<PageTitle>Eliminar Cuenta</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-10">
    <MudCard Class="pa-6" Style="background-color: var(--av-bg-pure); border-radius: var(--av-radius-lg); box-shadow: var(--av-shadow-premium);">
        <MudText Typo="Typo.h4" Class="mb-4 text-center" Align="Align.Center" Style="font-weight: 700; color: var(--av-text-main);">
            Eliminar Cuenta
        </MudText>

        @if (!string.IsNullOrEmpty(message))
        {
            <MudAlert Severity="@(message.StartsWith("Error") ? Severity.Error : Severity.Success)" Variant="Variant.Outlined" Class="mb-4" Style="border-radius: 8px;">
                @message
            </MudAlert>
        }

        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-6" Style="border-radius: 8px;">
            <strong>¡Acción irreversible!</strong> Al confirmar, tus datos y tu cuenta serán eliminados de forma permanente y no podrán ser recuperados.
        </MudAlert>

        <EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />

            @if (requirePassword)
            {
                <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--av-text-muted);">
                    Por motivos de seguridad, introduce tu contraseña para confirmar esta acción.
                </MudText>

                <div style="position: relative;" class="mb-6">
                    <MudTextField @bind-Value="Input.Password"
                                  For="@(() => Input.Password)"
                                  Name="Input.Password"
                                  Label="Contraseña"
                                  InputType="InputType.Password"
                                  Placeholder="********"
                                  Required="true"
                                  Variant="Variant.Outlined"
                                  ShrinkLabel="true"
                                  Class="m-0" />

                    <button type="button"
                            onclick="var input = document.querySelector('input[name=\'Input.Password\']'); if(input.type === 'password') { input.type = 'text'; this.style.color = 'var(--av-primary)'; } else { input.type = 'password'; this.style.color = '#757575'; }"
                            style="position: absolute; right: 14px; top: 16px; background: none; border: none; cursor: pointer; color: #757575; z-index: 10; transition: color 0.3s ease;">
                        <svg width="24" height="24" viewBox="0 0 24 24">
                            <path fill="currentColor" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                        </svg>
                    </button>
                </div>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       FullWidth="true"
                       ButtonType="ButtonType.Submit"
                       Size="Size.Large"
                       Style="font-weight: 600; border-radius: 8px; letter-spacing: 0.5px;">
                Eliminar cuenta definitivamente
            </MudButton>
        </EditForm>
    </MudCard>
</MudContainer>

@code {
    private string? message;
    private ApplicationUser? user;
    private bool requirePassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }
        requirePassword = await UserManager.HasPasswordAsync(user);
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (requirePassword && !await UserManager.CheckPasswordAsync(user, Input.Password))
        {
            message = "Error: La contraseña es incorrecta.";
            return;
        }

        var result = await UserManager.DeleteAsync(user);
        if (!result.Succeeded)
        {
            throw new InvalidOperationException("Se produjo un error inesperado al eliminar el usuario.");
        }

        await SignInManager.SignOutAsync();

        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("El usuario con ID '{UserId}' ha eliminado su propia cuenta.", userId);

        RedirectManager.RedirectToCurrentPage();
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "La contraseña es obligatoria para confirmar.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}