@page "/Account/Manage/PersonalData"

@using Domain.Models
@using Microsoft.AspNetCore.Identity
@using Data.Context

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Datos personales</PageTitle>

<MudText Typo="Typo.h5" Style="font-weight: 700; color: #2D3436;" Class="mb-4">Datos personales</MudText>

<StatusMessage />

<MudGrid>
    <MudItem xs="12" md="8" lg="6">

        <MudText Typo="Typo.body1" Class="mb-4" Style="color: #636e72;">
            Tu cuenta contiene información personal que nos has proporcionado. Esta página te permite descargar una copia de tus datos o eliminarlos por completo de nuestro sistema.
        </MudText>

        <MudAlert Severity="Severity.Warning" Class="mb-6" Style="border-radius: 8px;">
            <strong>¡Atención!</strong> Eliminar estos datos borrará permanentemente tu cuenta, y esta acción no se puede deshacer.
        </MudAlert>

        <div class="d-flex flex-column gap-4">
            <form action="Account/Manage/DownloadPersonalData" method="post" class="m-0 w-100">
                <AntiforgeryToken />
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Outlined.Download"
                           Style="font-weight: 600; border-radius: 8px;">
                    Descargar mis datos
                </MudButton>
            </form>

            <MudButton Href="Account/Manage/DeletePersonalData"
                       Variant="Variant.Outlined"
                       Color="Color.Error"
                       Size="Size.Large"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Outlined.DeleteForever"
                       Style="font-weight: 600; border-radius: 8px; border-width: 2px;">
                Eliminar cuenta
            </MudButton>
        </div>

    </MudItem>
</MudGrid>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}