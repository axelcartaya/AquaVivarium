@using Domain.Models
@using Microsoft.AspNetCore.Identity
@using Data.Context

@inject SignInManager<ApplicationUser> SignInManager

<MudPaper Elevation="2" Class="py-2" Style="border-radius: 12px;">
    <MudNavMenu Color="Color.Primary">
        <MudNavLink Href="Account/Manage" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Person">
            Perfil
        </MudNavLink>

        <MudNavLink Href="Account/Manage/Email" Icon="@Icons.Material.Outlined.Email">
            Email
        </MudNavLink>

        <MudNavLink Href="Account/Manage/ChangePassword" Icon="@Icons.Material.Outlined.Lock">
            Contraseña
        </MudNavLink>

        @if (hasExternalLogins)
        {
            <MudNavLink Href="Account/Manage/ExternalLogins" Icon="@Icons.Material.Outlined.Link">
                Logins externos
            </MudNavLink>
        }

        <MudNavLink Href="Account/Manage/TwoFactorAuthentication" Icon="@Icons.Material.Outlined.Security">
            Autenticación 2FA
        </MudNavLink>

        <MudNavLink Href="Account/Manage/PersonalData" Icon="@Icons.Material.Outlined.FolderShared">
            Datos personales
        </MudNavLink>
    </MudNavMenu>
</MudPaper>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}