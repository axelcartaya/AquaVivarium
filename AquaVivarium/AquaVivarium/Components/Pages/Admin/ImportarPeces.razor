@page "/admin/importar"
@rendermode InteractiveServer
@using System.Text.Json
@using Domain.Interfaces.Repositories
@using Domain.Models
@using global::AquaVivarium.DTOs
@inject IEspecieRepository EspecieRepo
@inject IPezRepository PezRepo
@inject NavigationManager Nav


<div class="container mt-4">
    <h3>Importador Masivo de Peces</h3>
    <p class="text-muted">Pega el código JSON aquí abajo para llenar la base de datos.</p>

    <div class="mb-3">
        <textarea @bind="jsonRaw" class="form-control" rows="10" placeholder='[ { "Nombre": "Neón", ... } ]'></textarea>
    </div>

    @if (procesando)
    {
        <div class="alert alert-info">Procesando importación... no cierres la página.</div>
    }

    <button class="btn btn-primary" @onclick="EjecutarImportacion" disabled="@string.IsNullOrWhiteSpace(jsonRaw)">
        Iniciar Importación
    </button>
</div>

@code {
    private string jsonRaw = "";
    private bool procesando = false;

    private async Task EjecutarImportacion()
    {
        try
        {
            procesando = true;
            await ProcesarImportacion(jsonRaw);
            Nav.NavigateTo("/peces"); 
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            procesando = false;
        }
    }
    private async Task ProcesarImportacion(string jsonRaw)
    {
        var opciones = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
        var listaDto = JsonSerializer.Deserialize<List<ImportPezDto>>(jsonRaw, opciones);

        foreach (var dto in listaDto)
        {
            var nuevaEspecie = new Especie
            {
                Nombre = dto.Nombre,
                NombreCientifico = dto.NombreCientifico,
                Familia = dto.Familia,
                Genero = dto.Genero,
                Origen = dto.Origen,
                Descripcion = dto.Descripcion,
                PhMin = dto.PhMin,
                PhMax = dto.PhMax,
                TempMin = dto.TempMin,
                TempMax = dto.TempMax,
                GhMin = dto.GhMin,
                GhMax = dto.GhMax,
                Dificultad = dto.Dificultad,
                TipoEspecie = "Pez"
            };

            await EspecieRepo.AddAsync(nuevaEspecie);

            var nuevoPez = new Pez
            {
                EspecieId = nuevaEspecie.Id,
                TamanoMaxCm = dto.PezInfo.TamanoMaxCm,
                Temperamento = dto.PezInfo.Temperamento,
                ZonaNado = dto.PezInfo.ZonaNado,
                Gregarismo = dto.PezInfo.Gregarismo,
                Alimentacion = dto.PezInfo.Alimentacion
            };

            await PezRepo.AddAsync(nuevoPez);
        }
    }
}