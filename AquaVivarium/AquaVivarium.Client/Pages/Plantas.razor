@page "/plantas"
@using AquaVivarium.Client.Components
@using Domain.Interfaces.Services
@using Domain.Models
@using Domain.Models.DTOs
@inject IPlantaService PlantaService
@inject IJSRuntime JS
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h3" Class="av-text-main mb-4" Style="font-weight: 800;"> Galería de Plantas </MudText>

    <FiltroPlanta Filtro="_filtro" OnBuscar="AplicarFiltros" OnLimpiar="LimpiarFiltros" />

    @if (_plantas == null)
    {
        <div class="d-flex justify-center align-center" style="height: 400px;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (!_plantas.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
            No se encontraron plantas con los filtros especificados.
        </MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var planta in _plantas)
            {
                if (planta?.Especie != null)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <EspecieCard EspecieId="@planta.Especie.Id"
                                     Nombre="@planta.Especie.Nombre"
                                     NombreCientifico="@planta.Especie.NombreCientifico"
                                     Imagenes="@planta.Especie.EspecieImagenes.ToList()"
                                     RutaBase="plantas" /> 
                    </MudItem>
                }
            }
        </MudGrid>

        @if (_totalPaginas > 1)
        {
            <div class="d-flex justify-center mt-10 mb-10">
                <MudPagination Color="Color.Primary"
                               Variant="Variant.Filled"
                               Count="@_totalPaginas"
                               Selected="_currentPage"
                               SelectedChanged="OnPageChanged" />
            </div>
        }
    }
</MudContainer>

@code {
    private List<Planta>? _plantas;
    private FiltroPlantaDto _filtro = new();
    private int _totalItems;
    private int _pageSize = 44;
    private int _currentPage = 1;

    private int _totalPaginas => (int)Math.Ceiling((decimal)_totalItems / _pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadData(1);
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadData(page);
        await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    private async Task AplicarFiltros()
    {
        _currentPage = 1;
        await LoadData(1);
    }

    private async Task LimpiarFiltros()
    {
        _filtro = new FiltroPlantaDto();
        _currentPage = 1;
        await LoadData(1);
    }

    private async Task LoadData(int page)
    {
        _plantas = null;
        StateHasChanged();

        var (plantas, total) = await PlantaService.GetPlantasFiltradasAsync(_filtro, page, _pageSize);

        _plantas = plantas.ToList();
        _totalItems = total;

        StateHasChanged();
    }
}