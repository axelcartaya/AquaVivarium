@page "/simulador"
@page "/simulador/{Id:int}"

@using Domain.Models
@using Domain.Models.DTOs
@using Domain.Interfaces.Services

@inject IAcuarioService AcuarioService
@inject IEspecieService EspecieService
@inject IAcuarioIAService AcuarioIAService
@inject ISnackbar Snackbar
@inject NavigationManager NavManager
@inject IDialogService DialogService

@rendermode InteractiveWebAssembly

<PageTitle>Simulador - AquaVivarium</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8 mb-16">
    @* cabecera *@
    <div class="d-flex flex-column flex-md-row justify-space-between align-start align-md-center mb-8" style="gap: 16px;">
        <div class="pr-md-4">
            <MudText Typo="Typo.h4" Style="font-weight: 800; color: var(--av-text-main);" Class="mb-1">Simulador de Compatibilidad</MudText>
            <MudText Typo="Typo.subtitle1" Class="av-text-muted">Diseña tu entorno ideal y comprueba la convivencia de tus especies.</MudText>
        </div>

        <div class="d-flex flex-column flex-sm-row w-100 justify-end" style="gap: 12px; max-width: fit-content;">
            <AuthorizeView>
                <Authorized>
                    @* menú desplegable *@
                    <MudMenu Label="Mis Acuarios"
                             Variant="Variant.Outlined"
                             Color="Color.Primary"
                             StartIcon="@Icons.Material.Filled.FolderSpecial"
                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                             Size="Size.Large"
                             MaxHeight="400">

                        <MudMenuItem OnClick="PrepararNuevoAcuario" Icon="@Icons.Material.Filled.Add" IconColor="Color.Info">
                            <strong>Nuevo Acuario</strong>
                        </MudMenuItem>
                        <MudDivider />

                        @if (_listaMisAcuarios != null && _listaMisAcuarios.Any())
                        {
                            @foreach (var ac in _listaMisAcuarios)
                            {
                                <MudMenuItem OnClick="@(() => CargarAcuarioEnSimulador(ac))">
                                    @ac.Nombre (@ac.Litros L)
                                </MudMenuItem>
                            }
                        }
                        else
                        {
                            <MudMenuItem Disabled="true">No tienes acuarios guardados</MudMenuItem>
                        }
                    </MudMenu>

                    @* edición *@
                    @if (_idAcuarioGuardado.HasValue)
                    {
                        <MudTooltip Text="Eliminar este acuario" Color="Color.Error" Placement="Placement.Top">
                            @* Cambiado a Outlined para integrarse mejor en modo oscuro *@
                            <MudIconButton Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           Icon="@Icons.Material.Filled.Delete"
                                           OnClick="EliminarAcuario"
                                           Size="Size.Large">
                            </MudIconButton>
                        </MudTooltip>

                        @* Cambiado a Outlined para integrarse mejor en modo oscuro *@
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="GuardarAcuario"
                                   Disabled="_guardando"
                                   Size="Size.Large">
                            @(_guardando ? "Guardando..." : "Actualizar")
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="GuardarAcuario"
                                   Disabled="_guardando"
                                   Size="Size.Large">
                            @(_guardando ? "Guardando..." : "Guardar")
                        </MudButton>
                    }
                </Authorized>
                <NotAuthorized>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Surface"
                               StartIcon="@Icons.Material.Filled.Lock"
                               Href="/login"
                               Size="Size.Large"
                               Style="color: var(--av-text-muted);">
                        Inicia sesión para guardar
                    </MudButton>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    <MudGrid Spacing="4">
        @* coulmna izquierda *@
        <MudItem xs="12" lg="4">
            <MudPaper Class="pa-6 rounded-lg border" Elevation="0" Style="background-color: var(--av-bg-soft); border: 1px solid var(--av-border);">
                <div class="d-flex align-center mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Primary" Class="mr-2" />
                    <MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--av-text-main);">Detalles del acuario</MudText>
                </div>

                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_acuario.Nombre" Label="Nombre del Acuario" Variant="Variant.Outlined" Margin="Margin.Dense" Style="background-color: var(--av-bg-pure);" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudNumericField @bind-Value="_acuario.Litros" Label="Volumen Total (Litros)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Style="background-color: var(--av-bg-pure);" />
                    </MudItem>

                    <MudItem xs="4" sm="4">
                        <MudNumericField @bind-Value="_acuario.LargoCm" Label="Largo (cm)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Style="background-color: var(--av-bg-pure);" />
                    </MudItem>
                    <MudItem xs="4" sm="4">
                        <MudNumericField @bind-Value="_acuario.AnchoCm" Label="Ancho (cm)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Style="background-color: var(--av-bg-pure);" />
                    </MudItem>
                    <MudItem xs="4" sm="4">
                        <MudNumericField @bind-Value="_acuario.AltoCm" Label="Alto (cm)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Style="background-color: var(--av-bg-pure);" />
                    </MudItem>

                    <MudItem xs="12" Class="mt-4">
                        <MudText Typo="Typo.body2" Style="font-weight: 600; color: var(--av-text-main);">pH del Agua: <span>@_acuario.PhActual</span></MudText>
                        <MudSlider T="decimal" Value="@(_acuario.PhActual ?? 7.0m)" ValueChanged="@(v => _acuario.PhActual = v)" Min="4.0m" Max="9.0m" Step="0.1m" Color="Color.Primary" ValueLabel="false" />
                    </MudItem>

                    <MudItem xs="12" Class="mt-2">
                        <MudText Typo="Typo.body2" Style="font-weight: 600; color: var(--av-text-main);">Temperatura: <span>@_acuario.TempActual °C</span></MudText>
                        <MudSlider T="int" Value="@(_acuario.TempActual ?? 25)" ValueChanged="@(v => _acuario.TempActual = v)" Min="15" Max="35" Step="1" Color="Color.Primary" ValueLabel="false" />
                    </MudItem>

                    <MudItem xs="12" Class="mt-2 mb-4">
                        <MudText Typo="Typo.body2" Style="font-weight: 600; color: var(--av-text-main);">Dureza (GH): <span>@_acuario.GhActual °dGH</span></MudText>
                        <MudSlider T="int" Value="@(_acuario.GhActual ?? 10)" ValueChanged="@(v => _acuario.GhActual = v)" Min="0" Max="30" Step="1" Color="Color.Primary" ValueLabel="false" />
                    </MudItem>

                    <MudItem xs="6">
                        <MudSelect T="string" @bind-Value="_acuario.NivelIluminacion" Label="Iluminación" Variant="Variant.Outlined" Margin="Margin.Dense" Style="background-color: var(--av-bg-pure);">
                            <MudSelectItem Value="@("Baja")">Baja</MudSelectItem>
                            <MudSelectItem Value="@("Media")">Media</MudSelectItem>
                            <MudSelectItem Value="@("Alta")">Alta</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="6">
                        <MudSelect T="string" @bind-Value="_acuario.FlujoAgua" Label="Flujo" Variant="Variant.Outlined" Margin="Margin.Dense" Style="background-color: var(--av-bg-pure);">
                            <MudSelectItem Value="@("Lento")">Lento</MudSelectItem>
                            <MudSelectItem Value="@("Moderado")">Moderado</MudSelectItem>
                            <MudSelectItem Value="@("Fuerte")">Fuerte</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudSelect T="string" @bind-Value="_acuario.TipoSustrato" Label="Tipo de Sustrato" Variant="Variant.Outlined" Margin="Margin.Dense" Style="background-color: var(--av-bg-pure);">
                            <MudSelectItem Value="@("Arena")">Arena Fina</MudSelectItem>
                            <MudSelectItem Value="@("Grava")">Grava Fina</MudSelectItem>
                            <MudSelectItem Value="@("Nutritivo")">Sustrato Nutritivo</MudSelectItem>
                            <MudSelectItem Value="@("Inerte")">Sustrato Inerte</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" Class="d-flex align-center mt-2">
                        <MudSwitch T="bool?" @bind-Value="_acuario.TieneCo2" Color="Color.Primary" Label="Sistema de inyección de CO2" />
                    </MudItem>

                </MudGrid>
            </MudPaper>
        </MudItem>

        @* columna derecha *@
        <MudItem xs="12" lg="8">
            <MudPaper Class="pa-6 rounded-lg border d-flex flex-column" Elevation="0" Style="background-color: var(--av-bg-soft); border: 1px solid var(--av-border); min-height: 100%;">
                <div class="d-flex align-center mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Primary" Class="mr-2" />
                    <MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--av-text-main);">Habitantes del acuario</MudText>
                </div>

                <MudAutocomplete T="EspecieBusquedaDto"
                                 Placeholder="Buscar peces, plantas..."
                                 SearchFunc="@BuscarEnApi"
                                 ToStringFunc="@(e => e == null ? null : e.Nombre)"
                                 ValueChanged="@OnEspecieSeleccionada"
                                 Variant="Variant.Outlined"
                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                 AdornmentColor="Color.Primary"
                                 Clearable="true"
                                 Class="mb-4"
                                 Style="background-color: var(--av-bg-pure)">
                    <ItemTemplate Context="especie">
                        <div class="d-flex align-center">
                            @if (!string.IsNullOrWhiteSpace(especie.ImagenUrl))
                            {
                                <img src="@especie.ImagenUrl.Trim()" style="width: 32px; height: 32px; object-fit: cover; border-radius: 50%;" class="mr-3" />
                            }
                            else
                            {
                                <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-3">
                                    @especie.Nombre.FirstOrDefault()
                                </MudAvatar>
                            }
                            <div>
                                <MudText Typo="Typo.body2" Style="color: var(--av-text-main);">@especie.Nombre</MudText>
                                <MudText Typo="Typo.caption" Style="color: var(--av-text-muted);">@especie.NombreCientifico</MudText>
                            </div>
                        </div>
                    </ItemTemplate>
                </MudAutocomplete>

                <div class="flex-grow-1 rounded-lg pa-4" style="background-color: var(--av-bg-pure); border: 1px dashed var(--av-border); min-height: 350px;">
                    @if (_acuario.AcuarioEspecies == null || !_acuario.AcuarioEspecies.Any())
                    {
                        <div class="d-flex flex-column align-center justify-center text-center my-16" style="color: var(--av-text-muted);">
                            <MudIcon Icon="@Icons.Material.Filled.WaterDrop" Size="Size.Large" Class="mb-2" />
                            <MudText Typo="Typo.body1">El acuario está vacío.</MudText>
                            <MudText Typo="Typo.body2">Usa el buscador de arriba para poblar el ecosistema.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <div class="d-flex align-center mb-3" style="border-bottom: 2px solid var(--av-primary); padding-bottom: 4px;">
                                    <MudIcon Icon="@Icons.Material.Filled.SetMeal" Color="Color.Primary" Class="mr-2" Size="Size.Small" />
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: var(--av-text-main);">Peces</MudText>
                                </div>

                                @{
                                    var peces = _acuario.AcuarioEspecies.Where(ae => ae.Especie.TipoEspecie == "Pez").ToList();
                                }
                                @if (!peces.Any())
                                {
                                    <MudText Typo="Typo.body2" Style="color: var(--av-text-muted); font-style: italic;" Class="pa-2">No hay peces añadidos.</MudText>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var item in peces)
                                        {
                                            <MudPaper Class="pa-2 pa-sm-3 d-flex align-center justify-space-between" Elevation="1" Style="background-color: var(--av-bg-pure); border: 1px solid var(--av-border);">
                                                <div class="d-flex align-center flex-grow-1 mr-2" style="min-width: 0;">
                                                    <div class="rounded-circle mr-2 mr-sm-3 d-flex align-center justify-center flex-shrink-0" style="width: 36px; height: 36px; background-color: var(--av-bg-soft); overflow:hidden; border: 1px solid var(--av-border);">
                                                        @if (item.Especie.EspecieImagenes?.Any() == true)
                                                        {
                                                            <img src="@item.Especie.EspecieImagenes.First().Url" style="width:100%; height:100%; object-fit:cover;" />
                                                        }
                                                        else
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.SetMeal" Color="Color.Primary" Size="Size.Small" />
                                                        }
                                                    </div>
                                                    <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;">
                                                        <MudText Typo="Typo.body2" Style="font-weight: 700; color: var(--av-text-main);">@item.Especie.Nombre</MudText>
                                                    </div>
                                                </div>

                                                <div class="d-flex align-center flex-shrink-0">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="@(() => ModificarCantidad(item, -1))" Class="pa-1 pa-sm-2" />
                                                    <MudText Typo="Typo.body2" Class="mx-1" Style="font-weight: 800; color: var(--av-text-main);">@item.Cantidad</MudText>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => ModificarCantidad(item, 1))" Class="pa-1 pa-sm-2" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Class="ml-1 pa-1 pa-sm-2" OnClick="@(() => EliminarEspecie(item))" />
                                                </div>
                                            </MudPaper>
                                        }
                                    </div>
                                }
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <div class="d-flex align-center mb-3" style="border-bottom: 2px solid var(--av-primary); padding-bottom: 4px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Grass" Color="Color.Primary" Class="mr-2" Size="Size.Small" />
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: var(--av-text-main);">Plantas</MudText>
                                </div>

                                @{
                                    var plantas = _acuario.AcuarioEspecies.Where(ae => ae.Especie.TipoEspecie == "Planta").ToList();
                                }
                                @if (!plantas.Any())
                                {
                                    <MudText Typo="Typo.body2" Style="color: var(--av-text-muted); font-style: italic;" Class="pa-2">No hay plantas añadidas.</MudText>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var item in plantas)
                                        {
                                            <MudPaper Class="pa-2 pa-sm-3 d-flex align-center justify-space-between" Elevation="1" Style="background-color: var(--av-bg-pure); border: 1px solid var(--av-border);">
                                                <div class="d-flex align-center flex-grow-1 mr-2" style="min-width: 0;">
                                                    <div class="rounded-circle mr-2 mr-sm-3 d-flex align-center justify-center flex-shrink-0" style="width: 36px; height: 36px; background-color: var(--av-bg-soft); overflow:hidden; border: 1px solid var(--av-border);">
                                                        @if (item.Especie.EspecieImagenes?.Any() == true)
                                                        {
                                                            <img src="@item.Especie.EspecieImagenes.First().Url" style="width:100%; height:100%; object-fit:cover;" />
                                                        }
                                                        else
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.Grass" Color="Color.Success" Size="Size.Small" />
                                                        }
                                                    </div>
                                                    <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;">
                                                        <MudText Typo="Typo.body2" Style="font-weight: 700; color: var(--av-text-main);">@item.Especie.Nombre</MudText>
                                                    </div>
                                                </div>

                                                <div class="d-flex align-center flex-shrink-0">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="@(() => ModificarCantidad(item, -1))" Class="pa-1 pa-sm-2" />
                                                    <MudText Typo="Typo.body2" Class="mx-1" Style="font-weight: 800; color: var(--av-text-main);">@item.Cantidad</MudText>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => ModificarCantidad(item, 1))" Class="pa-1 pa-sm-2" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Class="ml-1 pa-1 pa-sm-2" OnClick="@(() => EliminarEspecie(item))" />
                                                </div>
                                            </MudPaper>
                                        }
                                    </div>
                                }
                            </MudItem>
                        </MudGrid>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* Paneles inferiores *@
    <MudGrid Spacing="4" Class="mt-2">

        @* sección matematica *@
        <MudItem xs="12">
            <MudPaper Class="pa-6 rounded-lg border" Elevation="0" Style="background-color: var(--av-bg-soft); border: 1px solid var(--av-border); border-left: 6px solid #74B816;">
                <MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--av-text-main);" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Circle" Class="mr-2 ms-n1" Color="Color.Primary" />
                    Análisis de Parámetros del Agua
                </MudText>

                <div class="d-flex flex-column gap-2">
                    @{
                        var alertas = GenerarAlertas();
                    }

                    @if (!alertas.Any())
                    {
                        @* Usamos MudAlert con Variant.Outlined para que gestione el tema automáticamente *@
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="pa-3">
                            <MudText Typo="Typo.body1" Style="font-weight: 500;">Todos los parámetros químicos (pH, Temperatura, GH y Litros) son ideales para las especies seleccionadas.</MudText>
                        </MudAlert>
                    }
                    else
                    {
                        @foreach (var alerta in alertas)
                        {
                            @* Transformamos los divs manuales en componentes de alerta dinámicos *@
                            <MudAlert Severity="@alerta.Severidad" Variant="Variant.Outlined" Class="pa-3">
                                <MudText Typo="Typo.body2">@alerta.Mensaje</MudText>
                            </MudAlert>
                        }
                    }
                </div>
            </MudPaper>
        </MudItem>

        @* sección IA *@
        <MudItem xs="12">
            <MudPaper Class="pa-6 rounded-lg border" Elevation="0" Style="background-color: var(--av-bg-soft); border: 1px solid var(--av-border); border-left: 6px solid #74B816;">
                <div class="d-flex justify-space-between align-start align-md-center flex-column flex-md-row gap-4">
                    <div>
                        <MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--av-text-main);" Class="mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.Circle" Class="mr-2 ms-n1" Color="Color.Primary" />
                            Dictamen de Compatibilidad Inteligente (IA)
                        </MudText>
                        <MudText Typo="Typo.body2" Class="av-text-muted mt-1">Evalúa temperamentos, agresividad inter-especie, competencia alimentaria, distribución de nado y mucho más.</MudText>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Style="background-color: #74B816; color: white; min-width: 250px;"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Psychology"
                               Disabled="!_acuario.AcuarioEspecies.Any()"
                               OnClick="SolicitarAnalisisIA">
                        Analizar Comportamiento
                    </MudButton>
                </div>

                <div class="mt-6 pa-5 rounded-lg" style="background-color: var(--av-bg-pure); min-height: 120px; border: 1px dashed var(--av-border)">
                    @if (!string.IsNullOrWhiteSpace(_acuario.UltimoAnalisisIA))
                    {
                        <MudText Typo="Typo.body1" Style="white-space: pre-line; line-height: 1.6; color: var(--av-text-main);">
                            @_acuario.UltimoAnalisisIA
                        </MudText>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-center justify-center av-text-muted" style="height: 100%; color: var(--av-text-muted);">
                            <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Large" Class="mb-2 opacity-30" />
                            <MudText Typo="Typo.body2">Añade especies y haz clic en el botón superior para generar un dictamen experto.</MudText>
                        </div>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* botones inferiores solo para móviles *@
    <div class="d-flex d-md-none flex-column gap-3 mt-8">
        <AuthorizeView>
            <Authorized>
                <MudMenu Label="Mis Acuarios"
                         Variant="Variant.Outlined"
                         Color="Color.Primary"
                         StartIcon="@Icons.Material.Filled.FolderSpecial"
                         EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                         Size="Size.Large"
                         MaxHeight="400"
                         FullWidth="true">

                    <MudMenuItem OnClick="PrepararNuevoAcuario" Icon="@Icons.Material.Filled.Add" IconColor="Color.Info">
                        <strong>Nuevo Acuario</strong>
                    </MudMenuItem>
                    <MudDivider />

                    @if (_listaMisAcuarios != null && _listaMisAcuarios.Any())
                    {
                        @foreach (var ac in _listaMisAcuarios)
                        {
                            <MudMenuItem OnClick="@(() => CargarAcuarioEnSimulador(ac))">
                                @ac.Nombre (@ac.Litros L)
                            </MudMenuItem>
                        }
                    }
                    else
                    {
                        <MudMenuItem Disabled="true">No tienes acuarios guardados</MudMenuItem>
                    }
                </MudMenu>

                @if (_idAcuarioGuardado.HasValue)
                {
                    <div class="d-flex gap-2">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="EliminarAcuario"
                                   Size="Size.Large"
                                   Style="flex: 1;">
                            Eliminar
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="GuardarAcuario"
                                   Disabled="_guardando"
                                   Size="Size.Large"
                                   Style="flex: 1;">
                            @(_guardando ? "Guardando..." : "Actualizar")
                        </MudButton>
                    </div>
                }
                else
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.CloudUpload"
                               OnClick="GuardarAcuario"
                               Disabled="_guardando"
                               Size="Size.Large"
                               FullWidth="true">
                        @(_guardando ? "Guardando..." : "Guardar")
                    </MudButton>
                }
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Surface"
                           StartIcon="@Icons.Material.Filled.Lock"
                           Href="/login"
                           Size="Size.Large"
                           Style="color: var(--av-text-muted);"
                           FullWidth="true">
                    Inicia sesión para guardar
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</MudContainer>

@code {
    [Parameter] public int? Id { get; set; }

    private Acuario _acuario = new() //valores por defecto
    {
        Nombre = "Mi acuario",
        Litros = 60,
        PhActual = 7.0m,
        TempActual = 25,
        GhActual = 10,
        TieneCo2 = false
    };

    private int? _idAcuarioGuardado;
    private bool _guardando = false;
    private bool _analizando = false;
    private List<Acuario> _listaMisAcuarios = new();

    protected override async Task OnInitializedAsync()
    {
        await Task.CompletedTask;
        await CargarListaAcuarios();
    }

    private async Task GuardarAcuario()
    {
        _guardando = true;
        StateHasChanged();

        try
        {
            var dtoParaGuardar = GenerarDto();

            if (_idAcuarioGuardado.HasValue)
            {
                var exito = await AcuarioService.UpdateDesdeDtoAsync(_idAcuarioGuardado.Value, dtoParaGuardar);

                if (exito)
                {
                    Snackbar.Add("¡Cambios guardados con éxito!", Severity.Success);
                    await CargarListaAcuarios();
                }
                else
                {
                    Snackbar.Add("No se pudieron actualizar los cambios.", Severity.Warning);
                }
            }
            else
            {
                var resultado = await AcuarioService.AddDesdeDtoAsync(dtoParaGuardar);

                if (resultado != null && resultado.Id > 0)
                {
                    _idAcuarioGuardado = resultado.Id;
                    Snackbar.Add("¡Acuario guardado en tu perfil!", Severity.Success);
                    await CargarListaAcuarios();
                }
                else
                {
                    Snackbar.Add("No se pudo guardar el acuario.", Severity.Warning);
                }
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Error de conexión al intentar guardar.", Severity.Error);
        }
        finally
        {
            _guardando = false;
            StateHasChanged();
        }
    }

    private async Task<IEnumerable<EspecieBusquedaDto>> BuscarEnApi(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return new List<EspecieBusquedaDto>();
        return await EspecieService.BuscarEspeciesAsync(value);
    }

    private async Task OnEspecieSeleccionada(EspecieBusquedaDto especieSeleccionada)
    {
        if (especieSeleccionada == null) return;

        _acuario.AcuarioEspecies ??= new List<AcuarioEspecie>();

        var existe = _acuario.AcuarioEspecies.FirstOrDefault(ae => ae.EspecieId == especieSeleccionada.Id);
        if (existe != null)
        {
            existe.Cantidad++;
        }
        else
        {
            try
            {
                var especieCompleta = await EspecieService.GetByIdAsync(especieSeleccionada.Id);
                if (especieCompleta != null)
                {
                    _acuario.AcuarioEspecies.Add(new AcuarioEspecie
                    {
                        EspecieId = especieCompleta.Id,
                        Especie = especieCompleta,
                        Cantidad = 1
                    });
                }
            }
            catch (Exception)
            {
                Snackbar.Add("Error al cargar los datos técnicos de la especie.", Severity.Error);
            }
        }

        StateHasChanged();
    }

    private void ModificarCantidad(AcuarioEspecie item, int cambio)
    {
        item.Cantidad += cambio;
        if (item.Cantidad <= 0)
        {
            _acuario.AcuarioEspecies.Remove(item);
        }
        StateHasChanged();
    }

    private void EliminarEspecie(AcuarioEspecie item)
    {
        _acuario.AcuarioEspecies.Remove(item);
        StateHasChanged();
    }

    private class Alerta
    {
        public string Mensaje { get; set; } = "";
        public Severity Severidad { get; set; }
    }

    private List<Alerta> GenerarAlertas()
    {
        var alertas = new List<Alerta>();

        if (_acuario.AcuarioEspecies == null || !_acuario.AcuarioEspecies.Any())
        {
            alertas.Add(new Alerta { Mensaje = "El acuario está vacío. Añade especies para comprobar sus parámetros.", Severidad = Severity.Info });
            return alertas;
        }

        foreach (var item in _acuario.AcuarioEspecies)
        {
            var especie = item.Especie;

            if (especie.TempMin.HasValue && _acuario.TempActual < especie.TempMin.Value)
                alertas.Add(new Alerta { Mensaje = $"[{especie.Nombre}] La temperatura debe ser de al menos {especie.TempMin}°C.", Severidad = Severity.Error });

            if (especie.TempMax.HasValue && _acuario.TempActual > especie.TempMax.Value)
                alertas.Add(new Alerta { Mensaje = $"[{especie.Nombre}] La temperatura no debe superar los {especie.TempMax}°C.", Severidad = Severity.Error });

            if (especie.PhMin.HasValue && _acuario.PhActual < especie.PhMin.Value)
                alertas.Add(new Alerta { Mensaje = $"[{especie.Nombre}] El pH debe ser de al menos {especie.PhMin}.", Severidad = Severity.Error });

            if (especie.PhMax.HasValue && _acuario.PhActual > especie.PhMax.Value)
                alertas.Add(new Alerta { Mensaje = $"[{especie.Nombre}] El pH no debe superar {especie.PhMax}.", Severidad = Severity.Error });

            if (especie.GhMin.HasValue && _acuario.GhActual < especie.GhMin.Value)
                alertas.Add(new Alerta { Mensaje = $"[{especie.Nombre}] La dureza (GH) debe ser de al menos {especie.GhMin}.", Severidad = Severity.Warning });

            if (especie.GhMax.HasValue && _acuario.GhActual > especie.GhMax.Value)
                alertas.Add(new Alerta { Mensaje = $"[{especie.Nombre}] La dureza (GH) no debe superar {especie.GhMax}.", Severidad = Severity.Warning });

            if (especie.TipoEspecie == "Planta" && especie.Planta != null)
            {
                var planta = especie.Planta;
                if (planta.NecesitaCo2 == true && _acuario.TieneCo2 == false)
                    alertas.Add(new Alerta { Mensaje = $"[{especie.Nombre}] Esta planta es exigente y requiere inyección de CO2 para sobrevivir.", Severidad = Severity.Error });
            }
        }

        return alertas.GroupBy(a => a.Mensaje).Select(g => g.First()).ToList();
    }

    private async Task SolicitarAnalisisIA()
    {
        _analizando = true;
        _acuario.UltimoAnalisisIA = "Consultando a la IA... esto tomará un par de segundos.";
        StateHasChanged();

        try
        {
            var peticionDto = GenerarDto();

            var veredicto = await AcuarioIAService.GenerarAnalisisIAAsync(peticionDto);
            _acuario.UltimoAnalisisIA = veredicto;
        }
        catch (Exception)
        {
            _acuario.UltimoAnalisisIA = "Ocurrió un error al generar el resumen de la IA. Inténtalo de nuevo más tarde.";
        }
        finally
        {
            _analizando = false;
            StateHasChanged();
        }
    }

    private AcuarioTransferDto GenerarDto()
    {
        return new AcuarioTransferDto
        {
            Nombre = _acuario.Nombre,
            Litros = _acuario.Litros,
            LargoCm = _acuario.LargoCm,
            AnchoCm = _acuario.AnchoCm,
            AltoCm = _acuario.AltoCm,
            PhActual = _acuario.PhActual,
            TempActual = _acuario.TempActual,
            GhActual = _acuario.GhActual,
            TipoSustrato = _acuario.TipoSustrato,
            NivelIluminacion = _acuario.NivelIluminacion,
            FlujoAgua = _acuario.FlujoAgua,
            UltimoAnalisisIA = _acuario.UltimoAnalisisIA,
            TieneCo2 = _acuario.TieneCo2,
            Especies = _acuario.AcuarioEspecies.Select(e => new EspecieTransferDto
            {
                EspecieId = e.EspecieId,
                Nombre = e.Especie.Nombre,
                TipoEspecie = e.Especie.TipoEspecie,
                Cantidad = e.Cantidad ?? 1
            }).ToList()
        };
    }
    private async Task CargarListaAcuarios()
    {
        try
        {
            _listaMisAcuarios = await AcuarioService.GetMisAcuariosAsync();
        }
        catch (Exception)
        {
            _listaMisAcuarios = new List<Acuario>();
        }
    }
    private async Task CargarAcuarioEnSimulador(Acuario ac)
    {
        if (ac == null) return;

        _idAcuarioGuardado = ac.Id;

        _acuario.Id = ac.Id;
        _acuario.Nombre = ac.Nombre;
        _acuario.Litros = ac.Litros;
        _acuario.LargoCm = ac.LargoCm;
        _acuario.AnchoCm = ac.AnchoCm;
        _acuario.AltoCm = ac.AltoCm;
        _acuario.PhActual = ac.PhActual;
        _acuario.TempActual = ac.TempActual;
        _acuario.GhActual = ac.GhActual;
        _acuario.FlujoAgua = ac.FlujoAgua;
        _acuario.NivelIluminacion = ac.NivelIluminacion;
        _acuario.TieneCo2 = ac.TieneCo2;
        _acuario.TipoSustrato = ac.TipoSustrato;
        _acuario.AcuarioEspecies = ac.AcuarioEspecies ?? new List<AcuarioEspecie>();
        _acuario.UltimoAnalisisIA = ac.UltimoAnalisisIA;

        _acuario.AcuarioEspecies = new List<AcuarioEspecie>();

        if (ac.AcuarioEspecies != null && ac.AcuarioEspecies.Any())
        {
            foreach (var ae in ac.AcuarioEspecies)
            {
                var especieCompleta = await EspecieService.GetByIdAsync(ae.EspecieId);
                if (especieCompleta != null)
                {
                    _acuario.AcuarioEspecies.Add(new AcuarioEspecie
                    {
                        EspecieId = ae.EspecieId,
                        Especie = especieCompleta,
                        Cantidad = ae.Cantidad
                    });
                }
            }
        }

        Snackbar.Add($"Acuario '{ac.Nombre}' cargado con éxito.", Severity.Info);
        StateHasChanged();
    }

    private void PrepararNuevoAcuario()
    {
        _idAcuarioGuardado = null; // al ser null, el vuelve a poner "guardar"
        _acuario = new Acuario { Nombre = "Nuevo Acuario" };
        _acuario.AcuarioEspecies = new List<AcuarioEspecie>();
        _acuario.UltimoAnalisisIA = null;

        Snackbar.Add("Lienzo en blanco listo para crear.", Severity.Info);
        StateHasChanged();
    }

  
    private async Task EliminarAcuario()
    {
        if (!_idAcuarioGuardado.HasValue) return;

        bool? confirmado = await DialogService.ShowMessageBoxAsync(
            "Eliminar Acuario",
            "¿Estás seguro de que deseas eliminar este acuario? Esta acción no se puede deshacer.",
            yesText: "Sí, eliminar", cancelText: "Cancelar");

        if (confirmado == true)
        {
            try
            {
                await AcuarioService.DeleteAsync(_idAcuarioGuardado.Value);

                Snackbar.Add("Acuario eliminado correctamente.", Severity.Error);

                await CargarListaAcuarios();
                PrepararNuevoAcuario();
            }
            catch (Exception)
            {
                Snackbar.Add("Hubo un error al intentar eliminar el acuario.", Severity.Error);
            }
        }
    }
}