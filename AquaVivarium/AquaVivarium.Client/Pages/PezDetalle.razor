@page "/peces/{Id:int}"
@using AquaVivarium.Client.Components
@using Domain.Models
@using Domain.Interfaces.Services
@using System.Net.Http.Json
@inject IPezService PezService
@inject IEspecieService EspecieService
@inject NavigationManager NavigationManager
@rendermode InteractiveWebAssembly

<PageTitle>@(Pez?.Especie?.Nombre ?? "Cargando...") • AquaVivarium</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mt-md-8 mb-16">
    @if (isLoading)
    {
        <div class="d-flex justify-center align-center" style="height: 60vh;">
            <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Medium" />
        </div>
    }
    else if (Pez == null || Pez.Especie == null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Text" Class="mt-4">
            No se encontró la información de esta especie.
        </MudAlert>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Volver" Class="mt-4">Volver</MudButton>
    }
    else
    {
        @* Volver atrás *@
        <div class="mb-4 mb-md-8">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBackIosNew"
                       OnClick="Volver"
                       Style="font-size: 0.75rem; letter-spacing: 2px; font-weight: 600; text-transform: uppercase;">
                Catálogo
            </MudButton>
        </div>

        <MudGrid Spacing="10" Class="mb-12">
            @* Columna izquierda *@
            <MudItem xs="12" md="6">
                @if (Pez.Especie.EspecieImagenes != null && Pez.Especie.EspecieImagenes.Any())
                {
                    <MudCarousel Style="height: clamp(300px, 50vh, 650px); width: 100%; background-color: var(--av-bg-soft); overflow: hidden; border-radius: var(--av-radius-sm);"
                                 ShowArrows="@(Pez.Especie.EspecieImagenes.Count > 1)"
                                 ShowBullets="@(Pez.Especie.EspecieImagenes.Count > 1)"
                                 AutoCycle="false"
                                 TData="EspecieImagen"
                                 ItemsSource="Pez.Especie.EspecieImagenes.ToList()">
                        <BulletTemplate Context="bulletContext">
                            <div style="width: 30px; height: 3px; background-color: var(--av-text-main); border-radius: 2px; opacity: 0.3; margin: 0 4px; cursor:pointer;" class="mud-carousel-bullet"></div>
                        </BulletTemplate>
                        <ItemTemplate Context="imagen">
                            <div class="d-flex justify-center align-center pa-2" style="width: 100%; height: 100%;">
                                <img src="@imagen.Url" alt="@Pez.Especie.Nombre" style="max-width: 100%; max-height: 100%; object-fit: contain; border-radius: var(--av-radius-sm);" />
                            </div>
                        </ItemTemplate>
                    </MudCarousel>
                }
                else
                {
                    <div style="height: clamp(300px, 50vh, 650px); background-color: var(--av-bg-soft); display:flex; align-items:center; justify-content:center; border-radius: var(--av-radius-sm);">
                        <MudText Typo="Typo.overline" Style="letter-spacing: 2px; color: var(--av-text-muted);">FOTOGRAFÍA NO DISPONIBLE</MudText>
                    </div>
                }
            </MudItem>

            @* Columna derecha *@
            <MudItem xs="12" md="6" Class="pr-md-8 pt-md-10">
                <MudText Typo="Typo.h2" Style="font-weight: 800; color: var(--av-text-main); line-height: 1.1; letter-spacing: -1px; font-size: clamp(2rem, 6vw, 3.75rem); overflow-wrap: break-word; hyphens: auto;" Class="mb-2">
                    @Pez.Especie.Nombre
                </MudText>

                <MudText Typo="Typo.h5" Style="font-family: 'Georgia', serif; font-style: italic; color: var(--av-text-muted); font-size: clamp(1.1rem, 3vw, 1.5rem); overflow-wrap: break-word;" Class="mb-2">
                    Nombre Científico: @Pez.Especie.NombreCientifico
                </MudText>
                <MudText Typo="Typo.h5" Style="font-family: 'Georgia', serif; font-style: italic; color: var(--av-text-muted); font-size: clamp(1.1rem, 3vw, 1.5rem);" Class="mb-10">
                    Familia: @Pez.Especie.Familia
                </MudText>

                @* Origen *@
                <div style="position: relative; overflow: hidden; background-color: var(--av-bg-soft); border: 1px solid var(--av-border); border-radius: var(--av-radius-sm); width: 100%;" class="pa-4 pa-md-6 mb-10">
                    <MudIcon Icon="@Icons.Material.Outlined.Public"
                             Style="position: absolute; right: -20px; bottom: -30px; font-size: 140px; color: var(--av-text-main); opacity: 0.04; pointer-events: none;" />

                    <div style="position: relative; z-index: 1;">
                        <div class="d-flex align-center mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" Style="color: var(--av-text-muted);" Class="mr-2" />
                            <MudText Typo="Typo.overline" Style="letter-spacing: 2px; color: var(--av-text-muted); font-weight: 600;">
                                DISTRIBUCIÓN Y HÁBITAT
                            </MudText>
                        </div>
                        <MudText Typo="Typo.body1" Style="color: var(--av-text-main); font-weight: 500; font-size: 1.1rem; line-height: 1.6;">
                            @Pez.Especie.Origen
                        </MudText>
                    </div>
                </div>

                <MudDivider Class="mb-8" Style="border-color: var(--av-border);" />

                @* Parámetros *@
                <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--av-text-main); letter-spacing: -0.5px;" Class="mb-2">
                    REQUERIMIENTOS TÉCNICOS
                </MudText>

                <MudGrid Spacing="4">
                    <MudItem xs="6" sm="4">
                        <MudText Typo="Typo.caption" Style="color: var(--av-text-muted); text-transform: uppercase; letter-spacing: 1px;">Rango pH</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight: 500; color: var(--av-text-main);">@Pez.Especie.PhMin - @Pez.Especie.PhMax</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudText Typo="Typo.caption" Style="color: var(--av-text-muted); text-transform: uppercase; letter-spacing: 1px;">Rango gH</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight: 500; color: var(--av-text-main);">@Pez.Especie.GhMin - @Pez.Especie.GhMax</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudText Typo="Typo.caption" Style="color: var(--av-text-muted); text-transform: uppercase; letter-spacing: 1px;">Temperatura</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight: 500; color: var(--av-text-main);">@Pez.Especie.TempMin°C - @Pez.Especie.TempMax°C</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudText Typo="Typo.caption" Style="color: var(--av-text-muted); text-transform: uppercase; letter-spacing: 1px;">Dificultad</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight: 500; color: var(--av-text-main);">@(Pez.Especie.Dificultad ?? "--")</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudText Typo="Typo.caption" Style="color: var(--av-text-muted); text-transform: uppercase; letter-spacing: 1px;">Tamaño Max.</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight: 500; color: var(--av-text-main);">@(Pez.TamanoMaxCm) cm</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudText Typo="Typo.caption" Style="color: var(--av-text-muted); text-transform: uppercase; letter-spacing: 1px;">Temperamento</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight: 500; color: var(--av-text-main); word-wrap: break-word;">@(Pez.Temperamento)</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudText Typo="Typo.caption" Style="color: var(--av-text-muted); text-transform: uppercase; letter-spacing: 1px;">Zona de nado</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight: 500; color: var(--av-text-main); word-wrap: break-word;">@(Pez.ZonaNado)</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudText Typo="Typo.caption" Style="color: var(--av-text-muted); text-transform: uppercase; letter-spacing: 1px;">Gregarismo</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight: 500; color: var(--av-text-main);">@(Pez.Gregarismo) ejem. mín.</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudText Typo="Typo.caption" Style="color: var(--av-text-muted); text-transform: uppercase; letter-spacing: 1px;">Alimentación</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight: 500; color: var(--av-text-main); word-wrap: break-word;">@(Pez.Alimentacion)</MudText>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>

        @* Descripción *@
        <MudGrid Class="mb-16">
            <MudItem xs="12">
                <MudDivider Class="mb-8" Style="border-color: var(--av-border);" />
                <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--av-text-main); letter-spacing: -0.5px;" Class="mb-2">
                    DESCRIPCIÓN DETALLADA
                </MudText>
                <div style="font-size: 1.1rem; line-height: 1.9; color: var(--av-text-main); font-weight: 300; overflow-wrap: break-word;" class="py-2 py-md-4">
                    @((MarkupString)(Pez.Especie.Descripcion ?? "No hay descripción disponible."))
                </div>
            </MudItem>
        </MudGrid>

        @* Comunidad *@
        <ComunidadEspecie EspecieId="Pez.Especie.Id"
                          Consultas="Pez.Especie.EspecieConsulta"
                          OnCambiosRealizados="CargarDatos" />
    }
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    private Pez? Pez;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            isLoading = true;
            Pez = await PezService.GetPezByIdAsync(Id);
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error al buscar el pez: {ex.Message}");
            Pez = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/peces");
    }
}