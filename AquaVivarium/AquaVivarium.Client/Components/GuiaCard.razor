@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavManager

<MudCard Elevation="@_elevation"
         Class="rounded-lg h-100 d-flex flex-column"
         Style="@($"cursor: pointer; overflow: hidden; background-color: var(--av-bg-pure); transition: all 0.3s ease-out; transform: translateY({_elevacionVertical}px);")"
         @onclick="NavegarAGuia"
         @onmouseenter="ActivarHover"
         @onmouseleave="DesactivarHover">

    <div style="position: relative;">
        @if (!string.IsNullOrEmpty(ImagenPortadaUrl))
        {
            <MudCardMedia Image="@ImagenPortadaUrl" Height="180" Style="object-fit: cover;" />
        }
        else
        {
            <div class="d-flex justify-center align-center" style="height: 180px; background-color: var(--av-bg-soft);">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" Color="Color.Default" />
            </div>
        }

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div style="position: absolute; top: 8px; right: 8px; z-index: 10;" @onclick:stopPropagation="true">
                    <MudTooltip Text="Editar Guía">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Info"
                                       Variant="Variant.Filled"
                                       Size="Size.Small"
                                       Href="@($"/admin/guias/editar/{GuiaId}")" />
                    </MudTooltip>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>

    <MudCardContent Class="flex-grow-1 pa-4">
        <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--av-text-main); line-height: 1.2;">
            @Titulo
        </MudText>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public int CategoriaId { get; set; }
    [Parameter] public int GuiaId { get; set; }
    [Parameter] public string Titulo { get; set; } = string.Empty;
    [Parameter] public string? ImagenPortadaUrl { get; set; }

    private int _elevation = 1;
    private int _elevacionVertical = 0;

    private void ActivarHover()
    {
        _elevation = 8;
        _elevacionVertical = -6;
    }

    private void DesactivarHover()
    {
        _elevation = 1;
        _elevacionVertical = 0;
    }

    private void NavegarAGuia()
    {
        NavManager.NavigateTo($"/categorias-guias/{CategoriaId}/leer/{GuiaId}");
    }
}