@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavManager

<MudCard Elevation="1" Class="rounded-lg h-100 d-flex flex-column" Style="cursor: pointer; overflow: hidden;" @onclick="NavegarAGuia">
    
    <div style="position: relative;">
        @if (!string.IsNullOrEmpty(ImagenPortadaUrl))
        {
            <MudCardMedia Image="@ImagenPortadaUrl" Height="180" Style="object-fit: cover;" />
        }
        else
        {
            <div class="d-flex justify-center align-center" style="height: 180px; background-color: #f8f9fa;">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" Color="Color.Default" />
            </div>
        }

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div style="position: absolute; top: 8px; right: 8px; z-index: 10;" @onclick:stopPropagation="true">
                    <MudTooltip Text="Editar Guía">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Info"
                                       Variant="Variant.Filled"
                                       Size="Size.Small"
                                       Class="mr-1"
                                       Href="@($"/admin/guias/editar/{GuiaId}")" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar Guía">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Variant="Variant.Filled"
                                       Size="Size.Small"
                                       OnClick="ConfirmarEliminacion" />
                    </MudTooltip>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
    
    <MudCardContent Class="flex-grow-1 pa-4">
        <MudText Typo="Typo.h6" Style="font-weight: 700; line-height: 1.2;">
            @Titulo
        </MudText>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public int CategoriaId { get; set; }
    [Parameter] public int GuiaId { get; set; }
    [Parameter] public string Titulo { get; set; } = string.Empty;
    [Parameter] public string? ImagenPortadaUrl { get; set; }
    
    [Parameter] public EventCallback<int> OnEliminar { get; set; }

    private async Task ConfirmarEliminacion()
    {
        if (OnEliminar.HasDelegate)
        {
            await OnEliminar.InvokeAsync(GuiaId);
        }
    }

    private void NavegarAGuia()
    {
        NavManager.NavigateTo($"/categorias-guias/{CategoriaId}/leer/{GuiaId}");
    }
}