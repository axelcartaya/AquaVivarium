@inject NavigationManager NavManager

<MudCard Elevation="0" Class="rounded-lg outline-card hover-card h-100 d-flex flex-column" @onclick="NavegarALaGuia">
    @if (!string.IsNullOrEmpty(ImagenPortadaUrl))
    {
        <MudCardMedia Image="@ImagenPortadaUrl" Height="180" />
    }
    else
    {
        <div class="fallback-img d-flex justify-center align-center">
            <MudIcon Icon="@Icons.Material.Filled.Article" Style="font-size: 3rem; opacity: 0.2;" />
        </div>
    }

    <MudCardContent>
        <MudText Typo="Typo.h6" Style="font-weight: 700; line-height: 1.3;" Class="av-text-main text-center">@Titulo</MudText>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public int CategoriaId { get; set; }
    [Parameter] public int GuiaId { get; set; }
    [Parameter] public string Titulo { get; set; } = string.Empty;
    [Parameter] public string? ImagenPortadaUrl { get; set; } 

    private void NavegarALaGuia()
    {
        NavManager.NavigateTo($"/categorias-guias/{CategoriaId}/leer/{GuiaId}");
    }
}