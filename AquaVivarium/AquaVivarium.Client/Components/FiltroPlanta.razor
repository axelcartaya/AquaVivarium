@using Domain.Models.DTOs

<MudExpansionPanels Class="mb-6" Elevation="2">
    <MudExpansionPanel Text="Filtros de Búsqueda" Icon="@Icons.Material.Filled.FilterAlt">
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="Filtro.Nombre" Label="Nombre" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="Filtro.Familia" Label="Familia" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="Filtro.Genero" Label="Género" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" @bind-Value="Filtro.Dificultad" Label="Dificultad" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense">
                    <MudSelectItem Value="@("Muy Fácil")" />
                    <MudSelectItem Value="@("Fácil")" />
                    <MudSelectItem Value="@("Media")" />
                    <MudSelectItem Value="@("Difícil")" />
                </MudSelect>
            </MudItem>

            <MudItem xs="6" sm="3" md="2">
                <MudNumericField @bind-Value="Filtro.PhDesde" Label="pH Mínimo" Variant="Variant.Outlined" Step="0.5M" Clearable="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudNumericField @bind-Value="Filtro.PhHasta" Label="pH Máximo" Variant="Variant.Outlined" Step="0.5M" Clearable="true" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="6" sm="3" md="2">
                <MudNumericField @bind-Value="Filtro.TempDesde" Label="Temp. Mín (ºC)" Variant="Variant.Outlined" Step="1" Clearable="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudNumericField @bind-Value="Filtro.TempHasta" Label="Temp. Máx (ºC)" Variant="Variant.Outlined" Step="1" Clearable="true" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="6" sm="3" md="2">
                <MudNumericField @bind-Value="Filtro.GhDesde" Label="GH Mínimo" Variant="Variant.Outlined" Step="1" Clearable="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudNumericField @bind-Value="Filtro.GhHasta" Label="GH Máximo" Variant="Variant.Outlined" Step="1" Clearable="true" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end gap-4 mt-2">
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="OnLimpiarClick">
                    Limpiar
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="OnBuscarClick">
                    Buscar
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    [Parameter]
    public FiltroPlantaDto Filtro { get; set; } = new();
    [Parameter]
    public EventCallback OnBuscar { get; set; }
    [Parameter]
    public EventCallback OnLimpiar { get; set; }

    private async Task OnBuscarClick()
    {
        await OnBuscar.InvokeAsync();
    }

    private async Task OnLimpiarClick()
    {
        await OnLimpiar.InvokeAsync();
    }
}