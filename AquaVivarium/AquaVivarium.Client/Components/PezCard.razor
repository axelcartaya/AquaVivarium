@using Domain.Interfaces.Services
@using Domain.Models
@inject IEspecieService EspecieService 
@inject NavigationManager NavigationManager

<div class="av-card-float" @onclick="VerDetalles">
    <div class="av-card-image-wrapper" style="height: 200px;">
        @{
            var imagenPrincipal = Imagenes?.FirstOrDefault(i => i.Url.Contains("principal"))
                                 ?? Imagenes?.FirstOrDefault();
        }

        @if (imagenPrincipal != null)
        {
            <MudImage Src="@imagenPrincipal.Url"
                      Alt="@Nombre"
                      ObjectFit="ObjectFit.Cover"
                      Style="width: 100%; height: 200px;" />
        }
        else
        {
          <p>Not found</p>
        }
    </div>

    @* Cuerpo tarjeta *@
    <div class="av-card-content">
        <h3 class="av-fish-name">@Nombre</h3>
        <p class="av-fish-scientific">@NombreCientifico</p>
    </div>
</div>

@code {
    [Parameter] public int EspecieId { get; set; }
    [Parameter] public string Nombre { get; set; } = "Especie";
    [Parameter] public string? NombreCientifico { get; set; } = "N/A";
    [Parameter] public List<EspecieImagen> Imagenes { get; set; } = new();

    private void VerDetalles()
    {
        NavigationManager.NavigateTo($"/peces/{EspecieId}");
    }
}