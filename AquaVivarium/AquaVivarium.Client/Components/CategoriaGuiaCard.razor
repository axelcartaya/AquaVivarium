@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavManager

<MudCard Elevation="@_elevation"
         Class="rounded-lg h-100 d-flex flex-column"
         Style="@($"cursor: pointer; overflow: hidden; background-color: var(--av-bg-pure); transition: all 0.3s ease-out; transform: translateY({_elevacionVertical}px);")"
         @onclick="NavegarACategoria"
         @onmouseenter="ActivarHover"
         @onmouseleave="DesactivarHover">

    <div style="position: relative;">

        @if (!string.IsNullOrEmpty(ImagenPortadaUrl))
        {
            <MudCardMedia Image="@ImagenPortadaUrl" Height="220" Style="object-fit: cover;" />
        }
        else
        {
            <div class="d-flex justify-center align-center" style="height: 220px; background-color: var(--av-bg-soft); border-bottom: 1px solid var(--av-border);">
                <MudText Typo="Typo.h1" Style="font-weight: 900; color: var(--av-border);">
                    @(string.IsNullOrWhiteSpace(Nombre) ? "" : Nombre.Substring(0, 1).ToUpper())
                </MudText>
            </div>
        }

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div style="position: absolute; top: 12px; right: 12px; z-index: 10;" @onclick:stopPropagation="true">
                    <MudTooltip Text="Editar Categoría">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Info"
                                       Variant="Variant.Filled"
                                       Size="Size.Small"
                                       Class="mr-2"
                                       Href="@($"/admin/categorias/editar/{Id}")" />
                    </MudTooltip>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>

    <MudCardContent Class="flex-grow-1 pa-6">
        <MudText Typo="Typo.h5" Style="font-weight: 800; color: var(--av-text-main); line-height: 1.2;" Class="mb-3">
            @Nombre
        </MudText>
        <MudText Typo="Typo.body2" Style="color: var(--av-text-muted); line-height: 1.6;">
            @DescripcionBreve
        </MudText>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string Nombre { get; set; } = string.Empty;
    [Parameter] public string? DescripcionBreve { get; set; }
    [Parameter] public string? ImagenPortadaUrl { get; set; }
    [Parameter] public EventCallback<int> OnEliminar { get; set; }

    private int _elevation = 1;
    private int _elevacionVertical = 0;

    private async Task ConfirmarEliminacion()
    {
        if (OnEliminar.HasDelegate)
        {
            await OnEliminar.InvokeAsync(Id);
        }
    }

    private void ActivarHover()
    {
        _elevation = 8;
        _elevacionVertical = -3;
    }

    private void DesactivarHover()
    {
        _elevation = 1;
        _elevacionVertical = 0;
    }

    private void NavegarACategoria()
    {
        NavManager.NavigateTo($"/categorias-guias/{Id}");
    }
}