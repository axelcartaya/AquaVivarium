@using AquaVivarium.Client.Components
@using Domain.Interfaces.Services
@using Domain.Models
@using Domain.Models.DTOs
@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IEspecieService EspecieService

<MudPopoverProvider @rendermode="InteractiveWebAssembly" />
<MudDialogProvider @rendermode="InteractiveWebAssembly" />
<MudSnackbarProvider @rendermode="InteractiveWebAssembly" />
<MudLayout>
    @* Navbar *@
    <AppNavbar />

    <MudMainContent Class="pt-16 d-flex flex-column" Style="min-height: 100vh;">

        <MudContainer MaxWidth="MaxWidth.False" Class="mt-10 mb-16 flex-grow-1">
            @Body
        </MudContainer>

        <footer class="py-6 py-md-10 px-4 border-top d-flex justify-center align-center" style="background-color: var(--av-bg-pure)">
            <MudText Typo="Typo.caption" Align="Align.Center" Style="color: var(--av-text-muted); letter-spacing: 2px; line-height: 1.8;">
                ECOSISTEMAS EN EQUILIBRIO <span class="d-none d-sm-inline">—</span><br class="d-sm-none" /> AQUA•VIVARIUM 2026
            </MudText>
        </footer>

    </MudMainContent>
</MudLayout>
